# Copy this to .env and fill in real values. NEVER share your real .env.

# Used by docker-compose to configure the MariaDB container
DB_ROOT_PASSWORD=changeme_root
DB_NAME=weather_db
DB_USER=weather_app
DB_PASSWORD=changeme_app

# Used by src/db.py (your Python app) to connect to the DB.
# When the DB is running in Docker via docker-compose.yml above,
# connect to it at 127.0.0.1:3307 (see the port mapping in docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3307
